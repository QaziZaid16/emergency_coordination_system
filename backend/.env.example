# Copy to .env only for local development. Replace both values before any deployment.
DATABASE_URL=sqlite:///./data/coordination.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_MINUTES=30
REMEMBER_ME_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
PUBLIC_APP_URL=http://localhost:8000
# Optional SMTP delivery. Without this, development returns an activation URL
# to the authenticated administrator; production rejects undelivered invites.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
POSTGRES_PASSWORD=generate-a-long-random-password-for-compose
# Optional OpenRouter analysis; no provider is called by default. The key is
# server-side only. OpenRouter inference can incur usage charges.
AI_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it
# Legacy compatible-provider settings; leave blank when using OpenRouter.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=8
AI_MAX_ATTEMPTS=2
AI_RATE_LIMIT_PER_MINUTE=60
AI_SHARE_INCIDENT_LOCATION=false
# Transparent recommendation weights; the normalized total is displayed as a score out of 100.
RECOMMENDATION_DISTANCE_WEIGHT=45
RECOMMENDATION_CAPABILITY_WEIGHT=35
RECOMMENDATION_WORKLOAD_WEIGHT=20
